    description: "STT readiness score",
    unit: "score",
    type: "float",
    realtimeSafe: true,
    compute: (frame) => {
      const snr = estimateSNR(frame);
      const clipping = computeClippingRatio(frame);
      const silence = detectSilence(frame);

      if (silence) return 0;
      return Math.max(0, Math.min(100,
        (snr > 20 ? 50 : snr * 2.5) +
        (1 - clipping) * 50
