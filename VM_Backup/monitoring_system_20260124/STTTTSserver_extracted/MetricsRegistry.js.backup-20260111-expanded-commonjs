// =========================================================================
// HELPER FUNCTIONS
// =========================================================================

function getRealtimeMetrics() {
  return Object.entries(MetricsRegistry)
    .filter(([_, def]) => def.realtimeSafe)
    .map(([key]) => key);
}

function getAsyncMetrics() {
  return Object.entries(MetricsRegistry)
    .filter(([_, def]) => !def.realtimeSafe)
    .map(([key]) => key);
}

function computeMetric(key, frame, context = {}) {
  const metric = MetricsRegistry[key];
  if (!metric) {
    console.warn(`Unknown metric: ${key}`);
    return NaN;
  }

  if (!metric.compute) {
    return NaN; // Async metric or not implemented
  }

  try {
    return metric.compute(frame, context);
  } catch (err) {
    console.error(`Error computing metric ${key}:`, err);
    return NaN;
  }
}

function getMetricsByGroup(group) {
  return MetricGroups[group] || [];
}

